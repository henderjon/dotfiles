#!/usr/bin/env php
<?php

$owner       = $argv[1] ?? null;
$repo        = $argv[2] ?? null;
$nextVersion = $argv[3] ?? null;

$token = getenv("GITHUB_TOKEN");
if(!$token){ // fall back to gh cli
	$token = `gh auth token`;
}

if(!$token){
	fprintf(STDERR, "Error: No GitHub token found. Please set the GITHUB_TOKEN environment variable or authorize `gh`.\n");
	die(1);
}

if(!$repo || !$nextVersion || !$owner){
	fprintf(STDERR, "Usage: %s <owner/org> <repo> <version>\n", pathinfo($argv[0], PATHINFO_BASENAME));
	fprintf(STDERR, "  - <version> should contain only numbers and dot (`.`).\n");
	fprintf(STDERR, "    The `release` prefix is added automatically.\n");
	die(1);
}

if(!preg_match("/^[\d.]+$/", $nextVersion)){
	fprintf(STDERR, "Error: Branch names should contain only numbers and dot (`.`).\n");
	die(1);
}

$token = trim($token);
$headers = [
	"Accept: application/vnd.github+json",
	"Authorization: Bearer {$token}",
	"X-GitHub-Api-Version: 2022-11-28",
	"User-Agent: cURL; git-cut",
];

// get dev branch; https://docs.github.com/en/rest/git/refs?apiVersion=2022-11-28#get-a-reference
$dev = get("repos/{$owner}/{$repo}/git/ref/heads/dev", $headers);
if(!array_key_exists("ref", $dev)){
	fprintf(STDERR, "Error: %s\n", $dev["message"]);
	die(1);
}

// get previous releases; before creating new release branch to avoid counting it
$prevReleases = get("repos/{$owner}/{$repo}/git/matching-refs/heads/release", $headers);
if(!is_array($prevReleases)){
	fprintf(STDERR, "Error: %s\n", $prevReleases["message"]);
	die(1);
}

// create release branch
$newRelease = post("repos/{$owner}/{$repo}/git/refs", [
	"ref" => "refs/heads/release/{$nextVersion}",
	"sha" => $dev["object"]["sha"],
], $headers);

fprintf(STDERR, "I've cut a new branch `release/%s` from dev.\n\n", $nextVersion);

if(empty($prevReleases)){
	fprintf(STDERR, "There are no previous releases to compare against.\n");
	die(0);
}

// get last release for comparison
$lastRelease = array_reduce($prevReleases, function($carry, $release){
	$i = strnatcmp($carry["ref"], $release["ref"]);
	return match($i){
		1       => $carry,
		-1      => $release,
		default => $carry,
	};
}, $prevReleases[0]);

$lastReleaseRef = substr($lastRelease["ref"], strlen("refs/heads/"));
$nextReleaseRef = substr("refs/heads/release/{$nextVersion}", strlen("refs/heads/"));

fprintf(STDERR, "Here is a link to a list of all commits in `%s` that are not in the previous release `%s`:\n", $nextReleaseRef, $lastReleaseRef);
fprintf(STDERR, "https://github.com/%s/%s/compare/%s...%s\n\n", $owner, $repo, $lastReleaseRef, $nextReleaseRef);
fprintf(STDERR, "If you're looking for a list of all the merged PRs, run this command in terminal (or pipe the output of this script to %):\n");
// --merges only shows merge commits; --grep="pull request" only shows PR merges ... perhaps redundant?
// %an is author name; %h is short hash; %s is subject; %>(20) and %<(7) are padding
// $old..$new
fprintf(STDOUT, "git fetch --all && git log --merges --format=\"%%>(20)%%an | %%><(7)%%h | %%s\" --grep=\"pull request\" %s..%s", $lastRelease["object"]["sha"], $dev["object"]["sha"]);
fprintf(STDERR, "\n\n");

function get(string $path, array $headers) : array{
	$url = sprintf("https://api.github.com/%s", $path); // , urlencode(implode(" ", $query))
	$ch = curl_init($url);
	curl_setopt_array($ch, [
		CURLOPT_CUSTOMREQUEST  => "GET",
		CURLOPT_RETURNTRANSFER => true,
		CURLOPT_HTTPHEADER     => $headers,
	]);

	$response = curl_exec($ch);
	try{
		checkcURL($ch);
	}catch(\Exception $e){
		fprintf(STDERR, "Error: %s\n", $e->getMessage());
		fprintf(STDERR, "Response: %s\n", $response);
		die(1);
	}

	curl_close($ch);
	return json_decode($response, true);
}

function post(string $path, array $data, array $headers) : array{
	$url = sprintf("https://api.github.com/%s", $path);
	$ch = curl_init($url);
	curl_setopt_array($ch, [
		  // CURLOPT_URL => $url,
		CURLOPT_CUSTOMREQUEST  => "POST",
		CURLOPT_RETURNTRANSFER => true,
		CURLOPT_HTTPHEADER     => $headers,
		CURLOPT_POSTFIELDS     => json_encode($data),
	]);

	$response = curl_exec($ch);
	try{
		checkcURL($ch);
	}catch(\Exception $e){
		fprintf(STDERR, "Error: %s\n", $e->getMessage());
		fprintf(STDERR, "Response: %s\n", $response);
		die(1);
	}

	curl_close($ch);
	return json_decode($response, true);
}

function checkcURL(\Curlhandle $handle) : void {
	if(curl_errno($handle)){
		throw new \Exception(curl_error($handle), curl_errno($handle));
	}

	$status = curl_getinfo($handle, CURLINFO_HTTP_CODE);
	if($status < 200 || $status > 299){
		throw new Exception("HTTP Error: {$status}; ");
	}
}
