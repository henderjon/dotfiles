#!/usr/bin/env php
<?php

$owner       = $argv[1] ?? null;
$repo        = $argv[2] ?? null;
$nextVersion = $argv[3] ?? null;
// LOOK DOWN A BIT ... $base = $argv[4] ?? "dev";

$token = getenv("GITHUB_TOKEN");
if(!$token){ // fall back to gh cli
	$token = `gh auth token` ?? "";
}

if(!$token){
	fprintf(STDERR, "Error: No GitHub token found. Please set the GITHUB_TOKEN environment variable or authorize `gh`.\n");
	die(1);
}


if(!$repo || !$nextVersion || !$owner){
	fprintf(STDERR, "Usage: %s <owner/org> <repo> <version> [<base = dev>]\n", pathinfo($argv[0], PATHINFO_BASENAME));
	fprintf(STDERR, "  - <version> should contain only numbers and dot (`.`).\n");
	fprintf(STDERR, "    The `release` prefix is added automatically.\n");
	fprintf(STDERR, "  - <base> should be just the branch name (e.g., 'dev', not 'origin/dev').\n");
	fprintf(STDERR, "    The `origin/` prefix is added automatically.\n");
	die(1);
}

if(!preg_match("/^[\d.]+$/", $nextVersion)){
	fprintf(STDERR, "Error: Branch names should contain only numbers and dot (`.`).\n");
	die(1);
}

$token = trim($token ?? "");
$headers = [
	"Accept: application/vnd.github+json",
	"Authorization: Bearer {$token}",
	"X-GitHub-Api-Version: 2022-11-28",
	"User-Agent: cURL; git-cut-2",
];

// !!! SHELL COMMAND !!!
$defaultBranch = trim(`git symbolic-ref refs/remotes/origin/HEAD | sed 's|refs/remotes/origin/||'` ?? "");
$base        = $argv[4] ?? $defaultBranch;

if(empty($base)){
	fprintf(STDERR, "Error: Could not determine base branch. Please specify one as the 4th argument.\n");
	die(1);
}

fprintf(STDERR, "Fetching from remote...\n");
`git fetch --all`;

// Check for uncommitted changes
$statusOutput = trim(`git status --porcelain` ?? "");
if(!empty($statusOutput)){
	fprintf(STDERR, "\nError: You have uncommitted changes in your working directory.\n");
	fprintf(STDERR, "Please commit or stash your changes before creating a release branch.\n\n");
	fprintf(STDERR, "Uncommitted changes:\n%s\n", $statusOutput);
	die(1);
}

// Check if the release branch already exists locally
$existingLocal = trim(`git rev-parse --verify release/{$nextVersion} 2>/dev/null` ?? "");
if($existingLocal){
	fprintf(STDERR, "Error: Branch release/%s already exists locally.\n", $nextVersion);
	die(1);
}

// Check if the release branch already exists remotely
$existingRemote = trim(`git ls-remote --heads origin release/{$nextVersion}` ?? "");
if($existingRemote){
	fprintf(STDERR, "Error: Branch release/%s already exists on remote.\n", $nextVersion);
	die(1);
}

// get previous releases using git commands
fprintf(STDERR, "Getting previous releases...\n");
$prevReleasesOutput = `git branch -r -l 'origin/release/*' | sed 's|origin/||' | sed 's|^[[:space:]]*||'` ?? "";
$prevReleases = array_filter(explode("\n", trim($prevReleasesOutput)));

// Create local release branch from base
fprintf(STDERR, "Creating local branch release/%s from origin/%s...\n", $nextVersion, $base);
$output = `git checkout -b release/{$nextVersion} --no-track origin/{$base} 2>&1` ?? "";
$exitCode = 0;
exec("git rev-parse --verify release/{$nextVersion} 2>/dev/null", $checkOutput, $exitCode);

if($exitCode !== 0){
	fprintf(STDERR, "Error: Failed to create branch release/%s\n", $nextVersion);
	fprintf(STDERR, "%s\n", $output);
	die(1);
}

fprintf(STDERR, "\n");
fprintf(STDERR, str_repeat("=", 72));
fprintf(STDERR, "\n");
fprintf(STDERR, "SUCCESS: Local branch `release/%s` has been created from `%s`.\n\n", $nextVersion, $base);
fprintf(STDERR, "You can now add commits to this branch before publishing.\n");
fprintf(STDERR, "When you're ready to publish, run:\n");
fprintf(STDERR, "  git push -u origin release/%s\n\n", $nextVersion);
fprintf(STDERR, str_repeat("=", 72));
fprintf(STDERR, "\n\n");

if(cliConfirm("Push this branch to remote now?")){
	fprintf(STDERR, "Pushing release/%s to origin...\n", $nextVersion);
	$pushOutput = `git push -u origin release/{$nextVersion} 2>&1` ?? "";
	fprintf(STDERR, "%s\n", $pushOutput);

	// Check if push was successful
	exec("git ls-remote --heads origin release/{$nextVersion} 2>/dev/null", $verifyPush, $pushExitCode);
	if($pushExitCode !== 0 || empty($verifyPush)){
		fprintf(STDERR, "Error: Failed to push branch to remote.\n");
		die(1);
	}

	fprintf(STDERR, "\nBranch successfully published to remote!\n\n");
}

if(empty($prevReleases)){
	fprintf(STDERR, "There are no previous releases to compare against.\n");
	die(0);
}

// Sort releases naturally (version numbers)
usort($prevReleases, function($a, $b){
	return strnatcmp($b, $a); // descending order
});

$lastRelease = $prevReleases[0];
$nextReleaseRef = "release/{$nextVersion}";

fprintf(STDERR, "Here is a link to a list of all commits in `%s` that are not in the previous release `%s`:\n", $nextReleaseRef, $lastRelease);
fprintf(STDERR, "https://github.com/%s/%s/compare/%s...%s\n\n", $owner, $repo, $lastRelease, $nextReleaseRef);
fprintf(STDERR, "If you're looking for a list of all the merged PRs, run this command in terminal (or pipe the output of this script to `sh`):\n");

// Get the SHA for the last release and current branch
$lastReleaseSha = trim(`git rev-parse origin/{$lastRelease}` ?? "");
$currentSha = trim(`git rev-parse release/{$nextVersion}` ?? "");

if(empty($lastReleaseSha) || empty($currentSha)){
	fprintf(STDERR, "Error: Could not retrieve commit SHAs for comparison.\n");
	die(1);
}

// --merges only shows merge commits; --grep="pull request" only shows PR merges ... perhaps redundant?
// %an is author name; %h is short hash; %s is subject; %>(20) and %<(7) are padding
fprintf(STDOUT, "git fetch --all && git log --merges --format=\"%%<(20)%%an | %%><(7)%%h | %%s\" --grep=\"pull request\" %s..%s | sort", $lastReleaseSha, $currentSha);
fprintf(STDERR, "\n\n");

function cliConfirm( string $msg = "" ) : bool {
	$msg = $msg ?: "Is this what you want to do? ";
	printf("\n%s (y/n) ", $msg);

	return trim( fgets( STDIN ) ) == "y";
}
